{% style %}
  {% # Self-hosted Recoleta — regular (400) and bold (700), display: swap %}
  @font-face {
    font-family: 'Recoleta';
    src: url({{ 'recoleta-regular.otf' | asset_url }}) format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Recoleta';
    src: url({{ 'recoleta-bold.otf' | asset_url }}) format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-primary--family: 'Recoleta', Georgia, 'Times New Roman', serif;
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --content-grid: minmax(var(--page-margin), 1fr) minmax(0, min(var(--page-width), 100%)) minmax(var(--page-margin), 1fr);
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
