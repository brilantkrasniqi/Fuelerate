<input type='hidden' name='id' value='{{ variant.id }}'>
<button
  type='submit'
  name='add'
  class='bg-buttons flex cursor-pointer items-center justify-center rounded-full px-8 py-5 disabled:cursor-not-allowed disabled:opacity-50'
  {% unless variant.available %}
    disabled
  {% endunless %}
>
  <span class='text-brand-500 text-2xl leading-[1.2] uppercase'>
    {% if variant.available %}
      {{ 'products.add_to_cart' | t }}
    {% else %}
      {{ 'products.sold_out' | t }}
    {% endif %}
  </span>
</button>
