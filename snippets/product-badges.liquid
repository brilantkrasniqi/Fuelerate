{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign show_low_stock_badge = false
  if show_low_stock and current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity < 50
    assign show_low_stock_badge = true
  endif
  assign watcher_count = product.id | modulo: 73 | plus: 15
%}
{% if show_low_stock_badge or show_people_watching %}
  <div class='flex items-center gap-3'>
    {% if show_low_stock_badge %}
      <div class='bg-alert-400 flex items-center justify-center gap-2 rounded-3xl px-2 py-1'>
        <img
          src='{{ 'Alert-Red.svg' | asset_url }}'
          alt='{{ 'products.limited_stock_icon_alt' | t }}'
          width='20'
          height='20'
          class='h-4 w-4 shrink-0'
        >
        <span class='text-brand-500 leading-[1.1]'>{{ 'products.limited_stock' | t }}</span>
      </div>
    {% endif %}
    {% if show_people_watching %}
      <div class='bg-success-200 flex items-center gap-2 rounded-3xl px-2 py-1'>
        <img
          src='{{ 'Alert-Success.svg' | asset_url }}'
          alt='{{ 'products.people_watching_icon_alt' | t }}'
          width='20'
          height='20'
          class='h-4 w-4 shrink-0'
        >
        <span
          class='text-brand-500 leading-[1.1]'
          data-people-watching
          data-template='{{ 'products.people_watching' | t: count: '__COUNT__' | escape }}'
        >
          {{ 'products.people_watching' | t: count: watcher_count }}
        </span>
      </div>
    {% endif %}
  </div>
{% endif %}

{% javascript %}
  document.querySelectorAll('[data-people-watching]').forEach(function (element) {
    var min = 15;
    var max = 87;
    var randomCount = Math.floor(Math.random() * (max - min + 1)) + min;
    element.textContent = element.dataset.template.replace('__COUNT__', randomCount);
  });
{% endjavascript %}
