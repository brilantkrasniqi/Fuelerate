{% liquid
  assign loading = loading | default: 'lazy'
  assign image_size = width | append: 'x' | append: height
%}
{% case media.media_type %}
  {% when 'image' %}
    {{
      media
      | image_url: width: width, height: height, crop: 'center'
      | image_tag:
        width: width,
        height: height,
        loading: loading,
        alt: product.title,
        class: 'w-full h-full object-cover'
    }}
  {% when 'video' %}
    {{
      media
      | video_tag: image_size: image_size, controls: true, loading: loading, class: 'w-full h-full object-cover'
    }}
  {% when 'external_video' %}
    {{ media | external_video_tag: image_size: image_size, class: 'w-full h-full object-cover' }}
{% endcase %}
