<!doctype html>
<html lang='{{ request.locale.iso_code }}'>
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Preload the base Recoleta weight for initial page render. Bold loads
      on-demand from the @font-face rules in snippets/css-variables.liquid.
    {% endcomment %}
    {{ 'recoleta-regular.otf' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}

    {% # Load and preload the critical CSS %}
    {% comment %} {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }} {% endcomment %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <link rel='preconnect' href='https://cdn.jsdelivr.net' crossorigin>
    <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide-core.min.css'>
    <script
      id='splide-script'
      src='https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js'
      defer
    ></script>
    <script>
      window.whenSplide = function (callback) {
        if (typeof Splide !== 'undefined') {
          callback();
          return;
        }
        var script = document.getElementById('splide-script');
        if (script) {
          script.addEventListener('load', callback, { once: true });
        }
      };
    </script>

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
