<header class='border-brand-500/10 relative border-b bg-white'>
  <div class='mx-auto flex max-w-6xl items-center justify-between gap-5 px-5 py-4'>
    <a href='{{ routes.root_url }}' class='text-brand-500 shrink-0 text-2xl leading-none font-bold'>
      {{ shop.name }}
    </a>

    <nav class='hidden items-center gap-7 md:flex' aria-label='{{ 'general.primary_navigation' | t }}'>
      {% if section.settings.show_collections_menu and collections.size > 0 %}
        <details class='group relative'>
          <summary
            class='text-brand-500 hover:text-brand-300 flex cursor-pointer list-none items-center gap-1.5 leading-[1.1] [&::-webkit-details-marker]:hidden'
          >
            {{ 'general.shop' | t }}
            <svg
              class='h-2.5 w-2.5 shrink-0 transition-transform group-open:rotate-180'
              viewBox='0 0 12 8'
              fill='none'
              aria-hidden='true'
            >
              <path
                d="M1 1L6 6L11 1"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </summary>
          <div
            class='border-brand-500/10 absolute top-full left-0 z-10 mt-3 flex max-h-[70vh] min-w-52 flex-col gap-1 overflow-y-auto rounded-2xl border bg-white p-3 shadow-md'
          >
            <a
              href='{{ routes.all_products_collection_url }}'
              class='text-brand-500 hover:text-brand-300 rounded-lg px-3 py-2 leading-[1.1] font-bold'
            >
              {{ 'general.all_products' | t }}
            </a>
            {% for collection in collections %}
              <a
                href='{{ collection.url }}'
                class='text-brand-500 hover:text-brand-300 rounded-lg px-3 py-2 leading-[1.1]'
              >
                {{ collection.title }}
              </a>
            {% endfor %}
          </div>
        </details>
      {% endif %}
      {% for link in section.settings.menu.links %}
        <a
          href='{{ link.url }}'
          class='text-brand-500 hover:text-brand-300 leading-[1.1] {% if link.active %}font-bold{% endif %}'
        >
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collections_menu",
      "label": "t:labels.show_collections_menu",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
