{% assign current_variant = product.selected_or_first_available_variant %}
<div class='bg-lightgray mx-auto flex w-full min-w-50 justify-center pb-10'>
  {% form 'product', product %}
    {% render 'product-add-to-cart', variant: current_variant %}
  {% endform %}
</div>

{% stylesheet %}
  .product-buy-bar {
    display: grid;
    grid-template-columns: var(--content-grid);
    padding-block: 4rem;
  }
  .product-buy-bar__inner {
    grid-column: 2;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_buy_bar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Ready to feel the difference?"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_buy_bar"
    }
  ]
}
{% endschema %}
