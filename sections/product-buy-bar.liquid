{% assign current_variant = product.selected_or_first_available_variant %}
<div class='bg-lightgray flex w-full flex-col items-center gap-7.5 px-5 pb-10'>
  {% if section.settings.heading != blank %}
    <h2 class='text-brand-500 text-center text-2xl leading-[1.2] md:text-5xl'>
      {{ section.settings.heading }}
    </h2>
  {% endif %}
  {% form 'product', product %}
    {% render 'product-add-to-cart', variant: current_variant %}
  {% endform %}
</div>

{% schema %}
{
  "name": "t:general.product_buy_bar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Ready to feel the difference?"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_buy_bar"
    }
  ]
}
{% endschema %}
