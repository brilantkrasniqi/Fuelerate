{% comment %}
  Static end-of-page buy module: an optional heading, the product title,
  price, and add-to-cart. A second product form so shoppers can convert
  after reading the below-the-fold content without scrolling back up.
  Added to templates/product.json.
{% endcomment %}
{% assign current_variant = product.selected_or_first_available_variant %}
<div class='product-buy-bar'>
  <div class='product-buy-bar__inner flex flex-col items-center gap-6 text-center'>
    {% if section.settings.heading != blank %}
      <h2 class='text-brand-500 text-4xl leading-[1.2]'>{{ section.settings.heading }}</h2>
    {% endif %}

    <div class='flex flex-col items-center gap-2.5'>
      <p class='text-brand-500 text-3xl leading-[1.2] md:text-4xl'>{{ product.title }}</p>
      {% render 'product-price', variant: current_variant %}
    </div>

    {% form 'product', product %}
      {% render 'product-add-to-cart', variant: current_variant %}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .product-buy-bar {
    display: grid;
    grid-template-columns: var(--content-grid);
    padding-block: 4rem;
  }
  .product-buy-bar__inner {
    grid-column: 2;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_buy_bar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Ready to feel the difference?"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_buy_bar"
    }
  ]
}
{% endschema %}
