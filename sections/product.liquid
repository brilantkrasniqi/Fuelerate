{% comment %}
  Product hero: media gallery on one side, and the buy form (title, badges,
  description, price, featured reasons, add-to-cart, and content tabs) on
  the other. Each piece is a focused snippet so this section stays a thin
  orchestrator. Below-the-fold content (trust bar, benefits, comparison
  table) lives in its own sections in templates/product.json.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}
{% assign current_variant = product.selected_or_first_available_variant %}
<div class='grid gap-11.5 px-5 sm:p-0 md:grid-cols-2'>
  {% render 'product-media-gallery', product: product %}

  {% form 'product', product %}
    <div class='section-p-right flex flex-col gap-7.5'>
      <div class='flex flex-col gap-2.5'>
        <h1 class='text-brand-500 text-3xl leading-[1.2] md:text-5xl'>{{ product.title }}</h1>

        {% render 'product-badges',
          product: product,
          show_low_stock: section.settings.show_low_stock_badge,
          show_people_watching: section.settings.show_people_watching_badge
        %}

        {% if product.description %}
          <div class='rte **:text-brand-500 **:leading-[1.1]'>{{ product.description }}</div>
        {% endif %}

        {% render 'product-price', variant: current_variant %}
      </div>

      {% render 'product-featured-group', product: product %}

      {% render 'product-add-to-cart', variant: current_variant %}

      {% render 'product-content-tabs', product: product %}
    </div>
  {% endform %}
</div>

{% stylesheet %}
  .section-p-right {
    padding-right: clamp(1.25rem, -0.8135rem + 5.1587vw, 5.3125rem);
  }
  @media (max-width: 768px) {
    .section-p-right {
      padding-right: 0px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_low_stock_badge",
      "label": "t:labels.show_low_stock_badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_people_watching_badge",
      "label": "t:labels.show_people_watching_badge",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.product_hero"
    }
  ]
}
{% endschema %}
