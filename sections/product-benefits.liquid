{% comment %}
  Full-width benefits section for the product page. Driven by the
  product's custom.benefits metaobject (title, description, and a list of
  benefit items). Three Splide carousels are synced: the tab pills, the
  images, and the text panels. Renders nothing when the metafield is empty.
{% endcomment %}
{% liquid
  assign benefits = product.metafields.custom.benefits.value
  assign benefits_title = benefits.title
  assign benefits_description = benefits.description
  assign benefits_items = benefits.benefits.value
%}
{% if benefits_items.size > 0 %}
  <div class='bg-lightgray grid gap-0 px-5 pt-5 pb-6.5 md:px-17.5 md:pt-22 lg:grid-cols-2'>
    <div class='flex min-w-0 flex-col gap-6'>
      <div class='flex flex-col gap-1'>
        <h2 class='text-brand-500 text-2xl leading-[1.2] md:text-[64px]'>{{ benefits_title }}</h2>
        <p class='leading-[1.1]'>{{ benefits_description }}</p>
      </div>
      <div class='flex justify-between gap-4'>
        <div class='splide' id='benefits-tabs'>
          <div class='splide__track'>
            <ul class='splide__list'>
              {% for item in benefits_items %}
                <li
                  class='splide__slide group border-brand-500 [&.is-active]:bg-brand-500 [&.is-active]:border-brand-500 flex w-fit! cursor-pointer items-center gap-2.5 rounded-full border px-5 py-3'
                >
                  {{ item.tab_icon | image_url: width: 24 | image_tag: width: 24, height: 24, loading: 'lazy' }}
                  <span class='text-brand-500 leading-[1.1] group-[.is-active]:text-white'>{{ item.tab_title }}</span>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        <div class='splide hidden max-w-82.75 lg:flex lg:items-end' id='benefits-image'>
          <div class='splide__track'>
            <ul class='splide__list'>
              {% for item in benefits_items %}
                <li class='splide__slide w-fit'>
                  {{
                    item.benefit_image
                    | image_url: width: 331, height: 353, crop: 'center'
                    | image_tag: width: 331, height: 353, loading: 'lazy', class: 'object-cover'
                  }}
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class='splide bg-brand-300 min-w-0 overflow-hidden px-4.5 py-4.5 lg:px-25 lg:py-12.5' id='benefits-text'>
      <div class='splide__track'>
        <ul class='splide__list'>
          {% for item in benefits_items %}
            <li class='splide__slide'>
              <div class='flex min-w-0 flex-col justify-between gap-8.5'>
                <h3 class='text-2xl leading-[1.2] text-white md:text-5xl'>{{ item.tab_title }}</h3>
                <div class='rte wrap-break-word **:text-white'>
                  {{ item.benefit_description | metafield_tag }}
                </div>
                {% if item.link %}
                  <a href='{{ item.link }}' class='flex flex-col items-center justify-center gap-3'>
                    <img src='{{ 'TestTube.svg' | asset_url }}' width='24' height='24'>
                    <span class='leading-[1.1] font-bold text-white'>{{ 'products.benefits_science_link' | t }}</span>
                  </a>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
{% endif %}
{% stylesheet %}
  .splide__slide.group.is-active img {
    filter: brightness(1) invert(1);
  }
{% endstylesheet %}

{% javascript %}
  var benefitTabsEl = document.getElementById('benefits-tabs');
  var benefitImageEl = document.getElementById('benefits-image');
  var benefitTextEl = document.getElementById('benefits-text');

  if (benefitTabsEl && benefitImageEl && benefitTextEl && typeof Splide !== 'undefined') {
    var nav = new Splide(benefitTabsEl, {
      direction: 'ttb',
      isNavigation: true,
      height: 'auto',
      drag: false,
      pagination: false,
      arrows: false,
      gap: '10px',
    });

    var mainImage = new Splide(benefitImageEl, {
      rewind: true,
      type: 'fade',
      autoWidth: true,
      pagination: false,
      arrows: false,
      autoplay: true,
      interval: 10000,
    });

    var mainText = new Splide(benefitTextEl, {
      type: 'fade',
      drag: false,
      pagination: false,
      arrows: false,
    });

    mainImage.sync(nav);
    mainImage.sync(mainText);

    nav.mount();
    mainImage.mount();
    mainText.mount();
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product_benefits",
  "settings": [],
  "presets": [
    {
      "name": "t:general.product_benefits"
    }
  ]
}
{% endschema %}
